#record-list { padding: 1; }
#record-list-title { text-style: bold; height: 1; }
#record-list-filters { height: 3; }
#record-search { width: 1fr; }
#record-pending { width: auto; }
#record-list-summary { height: 1; }
#record-table { height: 1fr; }
#record-list-actions { height: auto; align: right middle; }
#record-list-actions Button { width: auto; min-width: 10; margin-left: 1; }

RecordOrderScreen { align: center middle; }
#record-order { width: 80%; height: 80%; border: tall $primary; padding: 1 2; background: $surface; }
#record-order > Static { height: auto; }
#record-order-controls { height: 3; }
#record-order-target { width: 1fr; }
#record-order-position { width: 14; }
#record-order-preview { height: 1fr; }
#record-order-actions { height: auto; align: right middle; padding-top: 1; }
#record-order-actions Button { margin-left: 1; }
